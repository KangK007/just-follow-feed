# 可选：指向本机运行的只读抓取服务（setup-sidecar.ps1 会自动写入此项）
FEED_SIDECAR_URL=http://127.0.0.1:8001

# 抖音浏览器同步使用的本机 Cookie 文件；setup-sidecar.ps1 会自动创建
DOUYIN_COOKIE_FILE=.local/douyin-cookie.txt

# 哔站侧车启动时读取的本机 Cookie 文件；不会写入第三方 Git 仓库
BILIBILI_COOKIE_FILE=.local/bilibili-cookie.txt

# 可选：找不到 Edge / Chrome 时，填写浏览器可执行文件路径
DOUYIN_BROWSER_EXECUTABLE=

# setup-sidecar.ps1 会在 .env.local 写入随机本机令牌；示例文件必须留空
FEED_SIDECAR_TOKEN=
